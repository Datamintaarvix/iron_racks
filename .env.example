# ==============================================================================
# MODI'S METAL RACKS & FURNITURES - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure keys for production or local deployment.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Razorpay Payment Gateway Credentials
# Obtain from: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Business Order Notification Email
BUSINESS_EMAIL=modismetalracks@gmail.com

# SMTP Email Configuration (Nodemailer / Sendgrid / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-business-email@gmail.com
SMTP_PASS=your-google-app-password

# WhatsApp Business Cloud API Credentials (Optional - Manual WhatsApp fallback is active by default)
WHATSAPP_TOKEN=EAABxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
BUSINESS_WHATSAPP_NUMBER=917892043478
SECONDARY_CONTACT_NUMBER=917090300368

# Persistent Database URL (PostgreSQL / MongoDB / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/modis_metal_racks

